generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RoomAssignment {
  assignment_id        String    @id @default(uuid()) @db.Uuid
  booking_id           String    @unique @db.Uuid
  physical_room_id     String?   @db.Uuid
  physical_room_number String    @db.VarChar(20)
  checked_in_at        DateTime  @default(now()) @db.Timestamptz(6)
  checked_out_at       DateTime? @db.Timestamptz(6)

  @@index([booking_id])
  @@map("room_assignments")
}

/**
 * Read model de llegadas: proyección local de booking.created/cancelled.
 * `booking_id` es la clave de idempotencia (replays del broker hacen upsert).
 * Sin FK entre bases: la referencia a Booking es solo el UUID.
 */
model Arrival {
  booking_id   String   @id @db.Uuid
  hotel_id     String   @db.Uuid
  room_type_id String   @db.Uuid
  guest_id     String   @db.Uuid
  guest_name   String?  @db.VarChar(255)
  check_in     DateTime @db.Date
  check_out    DateTime @db.Date
  channel      String   @default("direct") @db.VarChar(20)
  status       String   @default("confirmed") @db.VarChar(20)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  @@index([hotel_id, check_in])
  @@index([status])
  @@map("arrivals")
}

model EventOutbox {
  event_id   String    @id @default(uuid()) @db.Uuid
  event_type String    @db.VarChar(50)
  payload    Json      @db.Json
  status     String    @default("pending") @db.VarChar(20)
  attempts   Int       @default(0)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  sent_at    DateTime? @db.Timestamptz(6)

  @@index([status, created_at])
  @@map("event_outbox")
}

model GuestIncident {
  incident_id String   @id @default(uuid()) @db.Uuid
  booking_id  String   @db.Uuid
  // UUID externo copiado desde Booking para poder aplicar alcance por hotel
  // sin una FK entre las bases de datos de ambos servicios.
  hotel_id    String?  @db.Uuid
  description String   @db.Text
  status      String   @default("open") @db.VarChar(20)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([booking_id])
  @@index([hotel_id, created_at])
  @@map("guest_incidents")
}
